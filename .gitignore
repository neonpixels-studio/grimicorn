# Leftover temp file from an atomic write (see atomicWriteFileSync in
# asset-version-manifest.mjs) killed before it could rename into place or clean up.
# Scoped to the pattern temporaryPathFor() actually produces (<file>.<pid>-<hex>.tmp)
# rather than a bare *.tmp, so it can't accidentally hide an unrelated .tmp file.
.vitepress/asset-version-lock.json.*.tmp

# Local env (dotenvx). The encrypted .env* files ARE committed; the private
# keys and any local-only plaintext overrides are NOT.
.env.keys
.env.local
.env.*.local
