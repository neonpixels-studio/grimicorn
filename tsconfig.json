{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    // Skip type-checking bundled .d.ts files: vitepress ships a self-referential
    // `Token` type and @vueuse/core references Web Bluetooth globals, neither of
    // which we can fix and neither of which lives in our code.
    "skipLibCheck": true,
    // Let config.ts and the tests infer types from the plain-JS shared OG banner
    // spec's one source file (no parallel .d.ts to drift). allowJs enables reading
    // it for inference; it is not type-checked itself.
    "allowJs": true,
    // Mirror the resolve.alias entries in vitest.config.ts so vue-tsc resolves
    // the @components/@theme imports used by the test files.
    "paths": {
      "@components/*": ["./.vitepress/theme/components/*"],
      "@theme/*": ["./.vitepress/theme/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "og-banner-spec.mjs"
  ],
  "exclude": ["node_modules", ".vitepress/cache", ".vitepress/dist"]
}
