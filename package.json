{
  "name": "grimicorn-landing",
  "version": "1.0.0",
  "description": "Landing page for grimicorn.dev",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "generate:og": "node scripts/generate-og-banner.mjs",
    "lock:assets": "node scripts/regenerate-asset-version-lock.mjs",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "vitepress build && playwright test",
    "typecheck": "vue-tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prepare": "husky"
  },
  "overrides": {
    "nanoid@^3.3.0": "^3.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
