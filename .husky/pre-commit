# dotenvx: refuse the commit if any tracked .env* file holds plaintext values.
# `ext precommit` is deprecated in favor of `dotenvx protect`, but protect is not
# a gate: it exits 0 even with plaintext staged, and it installs a required clean
# filter into the GLOBAL ~/.gitconfig and ~/.config/git/attributes, pointing every
# repo's .env* files at this repo's node_modules. Keep ext precommit; ignore its
# deprecation warning.
npx dotenvx ext precommit

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed; install it with 'brew install gitleaks' (see the Requirements section of README.md for other platforms); the pre-commit secret scan cannot run without it." >&2
  exit 1
fi
gitleaks git --staged --redact --config .gitleaks.toml
